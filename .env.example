# ==============================================================================
# OMNIDEX SECURE BACKEND CONFIGURATION
# ==============================================================================
# NOTE: Do NOT commit your real keys or secrets to git!
# In Netlify: Go to Site Settings > Environment Variables, and set these there.
# Locally: Copy this file to .env.local and enter your private values.
# ==============================================================================

# Master Secret Key for Owner-Only Admin Dashboard Access
# Choose a strong alphanumeric password (e.g. OmnidexAdmin2026!SecureKey#)
ADMIN_SECRET_KEY=your_private_admin_secret_key_here

# (Optional) Supabase Database Integration for Permanent PostgreSQL Storage
# Create a free project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
